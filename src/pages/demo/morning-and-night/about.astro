---
import { Image } from 'astro:assets';
import Layout from '../../../components/demo/morning-and-night/Layout.astro';
import { base, links } from '../../../components/demo/morning-and-night/data.js';
import loaves from '../../../assets/demo/morning-and-night/loaves.jpg';
import swirlBread from '../../../assets/demo/morning-and-night/swirl-bread.jpg';
import brownies from '../../../assets/demo/morning-and-night/brownies.jpg';
---
<Layout
  title="About Me | Morning & Night Bakery Delights"
  description="A former teacher, now a stay-at-home mom, baking her favorite recipes for her Cincinnati neighbors."
  current="about"
>
  <section class="ahead">
    <div class="mn-wrap">
      <p class="mn-eyebrow">About me</p>
      <h1 class="ahead__title">From the classroom <br />to the <em>kitchen counter.</em></h1>
    </div>
    <figure class="ahead__photo">
      <Image src={loaves} alt="Four loaves of cinnamon swirl bread cooling on a wire rack" widths={[800, 1280, 1600]} sizes="100vw" loading="eager" />
    </figure>
  </section>

  <section class="story">
    <div class="mn-wrap story__grid">
      <div class="story__text">
        <p class="story__drop">
          As a former teacher, now a stay-at-home mom, I&rsquo;m bringing my favorite recipes to you.
        </p>
        <p>
          As a teacher and part of a large family, I&rsquo;ve shared these baked goods with a lot of people over the years.
          Baking is a passion, and each item is made with love. Now that I&rsquo;m at home full time, I&rsquo;m ready to keep
          baking and spread the love.
        </p>
        <p>
          Everything is baked in my home kitchen and picked up at my front porch stand on Saturdays.
        </p>
      </div>
      <aside class="story__photos" aria-hidden="true">
        <Image src={swirlBread} alt="" widths={[300, 520]} sizes="240px" class="story__p story__p--1" />
        <Image src={brownies} alt="" widths={[300, 520]} sizes="240px" class="story__p story__p--2" />
      </aside>
    </div>
  </section>

  <section class="name" aria-labelledby="name-h">
    <div class="mn-wrap">
      <h2 class="mn-h2 name__title" id="name-h">Where the name comes from</h2>
      <div class="name__grid">
        <div class="name__card name__card--am">
          <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="9" fill="currentColor"/><g stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M24 4v6M24 38v6M4 24h6M38 24h6M9.9 9.9l4.2 4.2M33.9 33.9l4.2 4.2M9.9 38.1l4.2-4.2M33.9 14.1l4.2-4.2"/></g></svg>
          <h3>Morning</h3>
          <p>Sweet breads and muffins for the start of your day.</p>
        </div>
        <span class="name__amp" aria-hidden="true">&amp;</span>
        <div class="name__card name__card--pm">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M30 6a18 18 0 1 0 12 30A15 15 0 0 1 30 6z" fill="currentColor"/></svg>
          <h3>Night</h3>
          <p>Sweet treats to end it. Put them together and you get Morning &amp; Night Bakery Delights.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="contact" aria-labelledby="contact-h">
    <div class="mn-wrap contact__grid">
      <div>
        <h2 class="mn-h2" id="contact-h">Questions or <em>suggestions?</em></h2>
        <p class="contact__lead">I&rsquo;d love to hear from you. Send me an email, or message me on Instagram or Facebook.</p>
      </div>
      <ul class="contact__list">
        <li><span>Email</span><a href={`mailto:${links.email}`}>{links.email}</a></li>
        <li><span>Instagram</span><a href={links.instagram} target="_blank" rel="noopener">@morningandnightbakerydelights</a></li>
        <li><span>Facebook</span><a href={links.facebook} target="_blank" rel="noopener">Morning &amp; Night Bakery Delights</a></li>
        <li><span>Order</span><a href={`${base}/menu`}>See the menu and stand dates</a></li>
      </ul>
    </div>
  </section>

  <style>
    .ahead { padding: 4rem 0 0; background: linear-gradient(180deg, #FFF6DA, var(--mn-cream)); }
    .ahead__title { font-family: var(--mn-ff-display); font-weight: 800; font-size: clamp(2.4rem, 6vw, 4.6rem); line-height: 1.03; letter-spacing: -0.02em; margin: 1rem 0 2.5rem; }
    .ahead__title em { font-weight: 500; color: var(--mn-crust); }
    .ahead__photo { margin: 0; max-width: 1400px; margin-inline: auto; padding: 0 1.5rem; }
    .ahead__photo img { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; object-position: center 60%; border-radius: 24px; }

    .story { padding: 5rem 0; }
    .story__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 4rem; align-items: start; }
    .story__text p { font-size: 1.12rem; line-height: 1.8; color: var(--mn-ink-soft); margin-bottom: 1.3rem; max-width: 58ch; }
    .story__text .story__drop { font-family: var(--mn-ff-display); font-size: clamp(1.5rem, 2.6vw, 1.95rem); line-height: 1.35; color: var(--mn-ink); }
    .story__photos { position: relative; height: 420px; }
    .story__p { position: absolute; width: 230px; aspect-ratio: 3 / 4; object-fit: cover; border: 7px solid #fff; border-radius: 12px; box-shadow: 0 20px 40px -20px rgba(45,53,66,.5); }
    .story__p--1 { left: 0; top: 0; transform: rotate(-4deg); }
    .story__p--2 { right: 0; bottom: 0; transform: rotate(5deg); }

    .name { padding: 5rem 0; background: linear-gradient(90deg, var(--mn-cream-deep) 50%, var(--mn-night-2) 50%); }
    .name__title { text-align: center; margin-bottom: 3rem; background: var(--mn-cream); width: fit-content; margin-inline: auto; padding: .4rem 1.4rem; border-radius: 999px; font-size: clamp(1.5rem, 3vw, 2.1rem); }
    .name__grid { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; }
    .name__card { padding: 2.4rem; border-radius: 22px; }
    .name__card svg { width: 46px; height: 46px; margin-bottom: 1rem; }
    .name__card h3 { font-family: var(--mn-ff-display); font-size: 2rem; margin-bottom: .5rem; }
    .name__card p { line-height: 1.65; max-width: 34ch; }
    .name__card--am { background: #fff; color: var(--mn-ink); }
    .name__card--am svg { color: var(--mn-gold); }
    .name__card--pm { background: var(--mn-night); color: var(--mn-moonlight); }
    .name__card--pm h3 { color: #fff; }
    .name__card--pm svg { color: var(--mn-butter); }
    .name__amp { font-family: var(--mn-ff-display); font-style: italic; font-size: 5rem; line-height: 1; color: var(--mn-gold); }

    .contact { padding: 5rem 0 6rem; }
    .contact__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 4rem; align-items: start; }
    .contact .mn-h2 em { font-style: italic; }
    .contact__lead { margin-top: 1rem; color: var(--mn-ink-soft); line-height: 1.7; max-width: 42ch; }
    .contact__list li { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--mn-line); }
    .contact__list span { font-size: .78rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--mn-crust); padding-top: .2rem; }
    .contact__list a { font-weight: 700; overflow-wrap: anywhere; border-bottom: 2px solid transparent; transition: border-color .2s; width: fit-content; }
    .contact__list a:hover { border-bottom-color: var(--mn-gold); }

    @media (max-width: 860px) {
      .ahead__photo img { aspect-ratio: 4 / 3; }
      .story__grid, .contact__grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .story__photos { height: 320px; max-width: 380px; }
      .story__p { width: 170px; }
      .name { background: var(--mn-cream-deep); }
      .name__grid { grid-template-columns: 1fr; gap: 1rem; }
      .name__amp { text-align: center; font-size: 3.5rem; }
      .contact__list li { grid-template-columns: 1fr; gap: .2rem; }
    }
  </style>
</Layout>
