---
import {Image} from "astro:assets";
import Layout from "../../../components/demo/gib-supply-chain/Layout.astro";
import Section from "../../../components/demo/gib-supply-chain/Section.astro";
import Eyebrow from "../../../components/demo/gib-supply-chain/Eyebrow.astro";
import Button from "../../../components/demo/gib-supply-chain/Button.astro";
import CertBadges from "../../../components/demo/gib-supply-chain/CertBadges.astro";
import LogoWall from "../../../components/demo/gib-supply-chain/LogoWall.astro";
import Scattered from "../../../components/demo/gib-supply-chain/Scattered.astro";
import Cockpit from "../../../components/demo/gib-supply-chain/Cockpit.astro";
import Stats from "../../../components/demo/gib-supply-chain/Stats.astro";
import Quote from "../../../components/demo/gib-supply-chain/Quote.astro";
import CaseStudy from "../../../components/demo/gib-supply-chain/CaseStudy.astro";
import Faq from "../../../components/demo/gib-supply-chain/Faq.astro";
import CtaBand from "../../../components/demo/gib-supply-chain/CtaBand.astro";
import hero from '../../../assets/demo/gib-supply-chain/hero-home.png';
import {base,links,moduleViews,faq} from '../../../components/demo/gib-supply-chain/data.js';
import {shot} from '../../../components/demo/gib-supply-chain/images.js';
const heroQuote = {"text": "Our partnership with GIB has enabled Nature’s Way to double the size of our operations without costly increases to our staff, hardware or other resources. The benefits of these supply chain tools have been felt throughout the company, from our production lines to our warehouses to our purchasing team.", "name": "Jean Treml", "role": "Materials Director at Nature's Way"};
const quotes = [{"text": "What we like most is that the solution runs directly inside SAP, so we don’t have to deal with the complexity of moving and synchronizing data between systems. It’s highly flexible to configure around our business needs, which allowed us to move through blueprinting and deployment very quickly, and the functionality and results are easy for our teams to understand.", "name": "Systems Manager, Sourcing", "role": "Manufacturer | +2B Annual Revenue"}, {"text": "In the short term, GIB helped us reduce operational processing times. In the midterm, we achieved higher productivity and better utilization of key production resources. Over the long term, we expect further improvements through optimized inventory levels and stronger delivery reliability. To give you an example, planning processing times for standard purchasing materials were reduced by up to 67%.", "name": "Peter Nickel", "role": "Baier & Schneider (BRUNNEN)"}, {"text": "Particular aspects such as functional scope, flexibility, cost of the solution, and the provider’s expertise were crucial factors in our decision-making process. GIB came out on top when compared with solutions presented by the other providers.", "name": "Udo Wessbecher", "role": "Head of IT, Supply Chain Management | ZF"}];
const benefits = [{"title": "Built Exclusively for SAP", "text": "Operational control embedded directly within SAP preserves system integrity while giving you a distinct advantage in how work is structured, prioritized, and executed."}, {"title": "Built-in, Not Bolted On", "text": "There is no data replication layer, no detached planning engine, and no separation between optimization and execution with GIB."}, {"title": "End-to-End Operational Scope", "text": "Grow your business on a fully coordinated supply chain , where demand, inventory, MRP, procurement, and production operate in sync."}];
const caseStudy = {"eyebrow": "Featured case study", "title": "Preparing for SAP S/4HANA: How TE Connectivity Standardized Supply Chain Operations", "text": "For many companies, the hardest part of S/4HANA isn’t the system upgrade. It’s the operational complexity that has accumulated inside SAP over time. With a global supply chain organization as large as TE Connectivity’s, that complexity had to be addressed before the migration began."};
const stats = [{"value": 42, "suffix": " hr", "label": "reduction in manual effort per buyer per month", "source": "GIB Operations"}, {"value": 40, "suffix": "%", "label": "inventory reduction in 11 months", "source": "GIB Inventory"}, {"value": 45, "suffix": "%", "label": "reduction in planning time, effort, and expense", "source": "GIB Forecast"}, {"value": 50, "suffix": "%", "label": "reduction in backorders", "source": "GIB Production"}];
const title = "GIB Platform | SAP Supply Chain Management Software";
const description = "Modernize SAP supply chain management with built-in cross-functional intelligence across planning, MRP, procurement, inventory, and production.";
---
<Layout title={title} description={description} current="home">
  <Section tone="dark"><div class="gib-hero">
    <div><Eyebrow text="For SAP S/4HANA and SAP ECC" /><h1>Everything you need is already in SAP. It's just not in one place.</h1><p class="gib-lead">GIB connects your supply chain processes end to end, so alert, analysis, and action happen in one place: inside SAP.</p><div class="gib-actions"><Button href={links.demo} external>Get a demo</Button><Button href={`${base}/platform`} variant="ghost">Explore the platform</Button></div><CertBadges /></div>
    <div class="gib-hero-panel"><Image src={hero} alt="GIB dashboard inside SAP with process indicators for demand planning, procurement, inventory and manufacturing" widths={[640,960,1280]} sizes="(min-width:900px) 45vw, 100vw" loading="eager" fetchpriority="high" /></div>
  </div></Section>
  <LogoWall />
  <Section tone="white"><Eyebrow text="From scattered to one screen" /><h2 class="reveal">SAP holds every signal. It doesn't connect them.</h2><p>The shortage, the material position, and the purchase order sit in separate screens. Coordinating a response across planners, buyers, and schedulers still happens in Excel and email.</p><Scattered /></Section>
  <Section tone="dark"><Eyebrow text="The GIB platform" /><h2 class="reveal">One cockpit for each part of your supply chain</h2><p class="gib-lead">GIB is deployed directly inside your SAP system as an SAP certified clean core extension. It reads your existing SAP data and executes through standard SAP processes. If a field exists in your SAP tables, GIB can use it.</p><Cockpit label="GIB Platform" id="modules" initial={2} views={moduleViews.map(v=>({...v,shot:shot(v.shot)}))} /></Section>
  <Section tone="light"><div class="gib-center"><h2 class="reveal">No separate database or system. No middleware.</h2><p class="gib-lead">Planners and buyers work in the SAP screens they already use, and every decision runs on current data, not a copy.</p></div><div class="gib-grid gib-grid-three gib-benefits">{benefits.map((b,i)=><article class:list={['gib-card','reveal',`reveal-delay-${i+1}`]}><h3>{b.title}</h3><p>{b.text}</p></article>)}</div><div class="gib-center"><Button href={`${base}/why-gib`} variant="link">See why customers choose GIB</Button></div></Section>
  <Section tone="dark"><Eyebrow text="Customer results" /><Stats items={stats} /></Section>
  <Section tone="white"><Quote {...heroQuote} featured /><div class="gib-grid gib-grid-three gib-home-quotes">{quotes.map(q=><Quote {...q} />)}</div></Section>
  <Section tone="light"><CaseStudy {...caseStudy} href={links.caseTE} /></Section>
  <Section tone="white"><div class="gib-grid gib-home-faq"><div><Eyebrow text="FAQ" /><h2 class="reveal">Common questions</h2></div><Faq items={faq} /></div></Section>
  <CtaBand heading="See GIB working inside SAP." text="Bring your own questions. The GIB team will walk through your planning, procurement, and production scenarios." />
</Layout>
<style>
.gib-benefits {margin:2.5rem 0 1rem;} .gib-home-quotes {margin-top:3rem;border-top:1px solid var(--gib-line);gap:2.5rem;} .gib-home-faq {grid-template-columns:1fr 2fr;gap:4rem;}
@media(max-width:899px) {.gib-home-faq {grid-template-columns:1fr;gap:1.5rem;}}
</style>
