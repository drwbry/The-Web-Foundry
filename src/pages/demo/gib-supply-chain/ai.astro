---
import { Image } from 'astro:assets';
import Layout from '../../../components/demo/gib-supply-chain/Layout.astro';
import Section from '../../../components/demo/gib-supply-chain/Section.astro';
import Eyebrow from '../../../components/demo/gib-supply-chain/Eyebrow.astro';
import Button from '../../../components/demo/gib-supply-chain/Button.astro';
import Stats from '../../../components/demo/gib-supply-chain/Stats.astro';
import CtaBand from '../../../components/demo/gib-supply-chain/CtaBand.astro';
import { links } from '../../../components/demo/gib-supply-chain/data.js';
import hero from '../../../assets/demo/gib-supply-chain/hero-ai.png';

const principles = [
  { title: 'Roadmap-driven, not trend-driven', text: 'AI capabilities are derived from product and customer requirements.' },
  { title: 'Secure integration, no added complexity', text: 'AI is built into GIB in a way that keeps your SAP environment clean: GDPR-compliant, audit-ready, and free of dependencies that create technical debt.' },
  { title: 'Pilot first, scale after validation', text: "We prove value in a controlled context before broad deployment. AI capabilities expand only after they've demonstrated measurable impact." },
  { title: 'Humans remain responsible', text: 'AI supports expertise, it does not replace it. Approvals, decisions, and accountability stay with your team.' },
];
const problems = [
  { title: 'Fragmented signals across transactions', text: 'Critical information is scattered across dozens of SAP transactions, reports, and dashboards. Teams manually piece together context before deciding what action to take.' },
  { title: 'Slow response to operational signals', text: "Material shortages, supplier delays, and inventory imbalances often surface too late, after they've already constrained production or affected service levels." },
  { title: 'Coordination across disconnected roles', text: 'Planners, buyers, and production teams often coordinate decisions through email or meetings rather than through structured workflows in SAP.' },
  { title: 'Spreadsheets substituting for SAP workflows', text: "When SAP doesn't surface the right operational context, teams export data to analyze it offline, adding latency and introducing version control problems." },
];
const features = [
  { title: 'Inventory Management', subtitle: 'Smarter inventory decisions, inside SAP', items: [
    { title: 'Safety Stock Optimization', lines: ['Machine Learning · Predicts optimal stock levels from historical consumption patterns', 'Linear Regression · Models the relationship between demand variables and required inventory'] },
    { title: 'Inventory Segmentation', lines: ['K-Means Clustering · Groups materials by similar behavior to apply the right inventory policy to each'] },
    { title: 'Master Data Management', lines: ['AI Agent · Applies large language models to support master data tasks within SAP'] },
  ] },
  { title: 'Demand & Forecast', subtitle: 'Forecast quality that improves what downstream teams act on', items: [
    { title: 'Time Series Clustering', lines: ['ROCKET · Identifies patterns across demand histories to group materials with similar behavior'] },
    { title: 'Material Selection', lines: ['Random Forest · Statistically ranks which materials most need active planning attention'] },
    { title: 'Risk Signal Detection', lines: ['Large Language Models · Monitors external signals to surface supply chain risks before they appear in SAP'] },
  ] },
  { title: 'Production Planning', subtitle: 'Production scheduling that accounts for real constraints', items: [
    { title: 'Factory Optimization Excellence (FOX)', lines: ['Constraint Satisfaction · Builds schedules that account material availability, capacity, and sequencing limits simultaneously', 'Mathematical Optimization · Finds the most efficient production sequence across competing constraints'] },
    { title: 'Production Order Duration Prediction', lines: ['Machine Learning · Predicts how long production orders will take based on historical execution data'] },
  ] },
  { title: 'Cross-Functional', subtitle: 'AI that works across the full supply chain, not just one function', items: [
    { title: 'Cross-Functional Data Intelligence', lines: ['Large Language Models · Enables natural language interaction with supply chain data across SAP', 'Knowledge Graphs · Maps how supply chain elements relate to each other, so a delay, shortage, or disruption surfaces its downstream impact automatically', 'SAP HANA Cloud · Underlying data foundation'] },
  ] },
];
const flow = [
  { title: 'Supply chain signals & planning systems', items: ['SAP IBP', 'GIB Forecast', 'Kinaxis, o9, others', 'Demand variability', 'Supplier lead time changes'] },
  { title: 'Operational intelligence within SAP', items: ['Issues surfaced before they escalate', 'Safety stock levels set by consumption patterns, not static rules', 'Production schedules that account for material and capacity constraints', 'Master data inconsistencies resolved automatically', 'Cross-functional decision coordination'] },
  { title: 'Operational actions in SAP', items: ['Purchase orders and requisitions', 'Inventory transfers and balancing', 'Production orders and schedules', 'Exception management'] },
];
const stats = [
  { text: '15-40%', label: 'Reduction in inventory levels', source: 'Typical range' },
  { text: '20-47%', label: 'Reduction in stockouts', source: 'Typical range' },
  { text: '10-40%', label: 'Improvement in employee productivity', source: 'Typical range' },
  { text: '10-50%', label: 'Reduction in production downtime', source: 'Typical range' },
];
---
<Layout title="AI in GIB | Embedded in SAP for Supply Chain Operations" description="GIB embeds AI directly into SAP supply chain workflows, improving safety stock optimization, demand forecasting, production scheduling, and master data management without adding complexity." current="platform">
  <Section tone="dark">
    <div class="gib-hero">
      <div>
        <Eyebrow text="AI in GIB" />
        <h1>AI, embedded where it delivers operational value</h1>
        <p class="gib-lead">GIB integrates AI directly into supply chain workflows within SAP to improve how teams detect issues, evaluate decisions, and execute across procurement, inventory, and production.</p>
        <div class="gib-actions"><Button href={links.demo} external>Talk to the team</Button><Button href="#ai-features" variant="ghost">See AI features</Button></div>
      </div>
      <div class="gib-hero-panel"><Image src={hero} alt="GIB supply chain platform with embedded AI capabilities inside SAP" widths={[640,960,1280]} sizes="(min-width:900px) 45vw, 100vw" loading="eager" fetchpriority="high" /></div>
    </div>
  </Section>

  <Section tone="light">
    <div class="gib-grid gib-grid-four">
      {principles.map((principle, i) => <article class:list={['gib-principle', 'reveal', `reveal-delay-${i+1}`]}><span class="gib-number">{String(i+1).padStart(2,'0')}</span><h2>{principle.title}</h2><p class="gib-muted">{principle.text}</p></article>)}
    </div>
  </Section>

  <Section tone="white">
    <h2 class="reveal">Where manual effort accumulates in SAP supply chains</h2>
    <p class="gib-lead gib-muted">Supply chain teams make hundreds of operational decisions daily, evaluating shortages, adjusting procurement, balancing inventory, rescheduling production. Most of that work depends on assembling context from multiple SAP transactions, reports, and planning tools before any action can be taken.</p>
    <div class="gib-grid gib-problems">{problems.map((problem,i) => <article class:list={['gib-card', 'reveal', `reveal-delay-${i+1}`]}><h3>{problem.title}</h3><p class="gib-muted">{problem.text}</p></article>)}</div>
  </Section>

  <Section tone="dark" id="ai-features">
    <h2 class="reveal">AI embedded in the GIB platform today</h2>
    <p class="gib-lead gib-muted">AI capabilities in GIB are already available across inventory management, demand forecasting, and production planning.</p>
    <div class="gib-grid gib-features">{features.map((feature,i) => <article class:list={['gib-card','reveal',`reveal-delay-${i+1}`]}><h3>{feature.title}</h3><p class="gib-feature-subtitle">{feature.subtitle}</p>{feature.items.map(item => <div class="gib-feature-item"><h4>{item.title}</h4><ul>{item.lines.map(line => <li>{line}</li>)}</ul></div>)}</article>)}</div>
    <p class="gib-muted gib-ai-disclaimer">Some AI capabilities listed are in active development or prototyping stages and may not be available in all product releases.</p>
  </Section>

  <Section tone="light">
    <h2 class="reveal">AI that strengthens SAP workflows</h2>
    <div class="gib-grid gib-grid-three gib-flow">{flow.map((step,i) => <article class:list={['gib-card','reveal',`reveal-delay-${i+1}`,{'gib-flow-center':i===1}]}><h3>{step.title}</h3><ul>{step.items.map(item => <li>{item}</li>)}</ul>{i<2 && <span class="gib-flow-arrow" aria-hidden="true">→</span>}</article>)}</div>
  </Section>

  <Section tone="dark">
    <Eyebrow text="What coordinated supply chain execution delivers" />
    <Stats items={stats} />
  </Section>
  <CtaBand heading="See how GIB applies AI to your supply chain operations." text="Talk with the GIB team about where AI can reduce manual effort and improve decision speed in your SAP environment." />
</Layout>

<style>
  .gib-principle {border-top:1px solid var(--gib-line);padding-top:1.5rem;}
  .gib-principle h2 {font-size:1.25rem!important;line-height:1.3!important;letter-spacing:0!important;margin-top:1rem!important;}
  .gib-problems,.gib-features,.gib-flow {margin-top:2rem;}
  .gib-feature-subtitle {color:var(--gib-orange);font-size:.95rem;}
  .gib-feature-item {border-top:1px solid var(--gib-ink-3);padding-top:1rem;margin-top:1rem;}
  .gib-feature-item h4 {font-size:.95rem;font-weight:600;margin-bottom:.6rem;}
  .gib-feature-item li {color:var(--gib-on-dark-muted);font-size:.9rem;line-height:1.6;margin-top:.5rem;}
  .gib-ai-disclaimer {font-size:.8rem;margin-top:1.5rem;}
  .gib-flow .gib-card {position:relative;}
  .gib-flow li {position:relative;padding-left:1rem;margin-top:.75rem;font-size:.95rem;}
  .gib-flow li::before {content:'';position:absolute;left:0;top:.65em;width:5px;height:5px;border-radius:50%;background:var(--gib-orange-ink);}
  .gib-flow .gib-flow-center {background:var(--gib-ink);border-color:var(--gib-ink-3);color:var(--gib-on-dark);}
  .gib-flow-center li {color:var(--gib-on-dark-muted);}
  .gib-flow-center li::before {background:var(--gib-orange);}
  .gib-flow-arrow {position:absolute;right:-1.35rem;top:50%;z-index:1;font-size:1.6rem;color:var(--gib-orange-ink);}
  @media(max-width:899px) {.gib-flow-arrow {top:auto;bottom:-1.85rem;right:50%;transform:translateX(50%) rotate(90deg);}}
</style>
