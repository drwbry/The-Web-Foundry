---
import { Image } from 'astro:assets';
import Layout from '../../../components/demo/gib-supply-chain/Layout.astro';
import Section from '../../../components/demo/gib-supply-chain/Section.astro';
import Eyebrow from '../../../components/demo/gib-supply-chain/Eyebrow.astro';
import Button from '../../../components/demo/gib-supply-chain/Button.astro';
import Quote from '../../../components/demo/gib-supply-chain/Quote.astro';
import ModuleCards from '../../../components/demo/gib-supply-chain/ModuleCards.astro';
import CtaBand from '../../../components/demo/gib-supply-chain/CtaBand.astro';
import { links } from '../../../components/demo/gib-supply-chain/data.js';
import hero from '../../../assets/demo/gib-supply-chain/hero-home.png';

const capabilities = [
  { title: 'Establish Shared Operational Visibility', text: 'See stock, supply, demand, and coverage across plants in a unified execution view.' },
  { title: 'Coordinate Across Functions', text: 'Enable planners, buyers, schedulers, and production teams to operate within shared workspaces inside SAP.' },
  { title: 'Prioritize Based on Impact', text: 'Surface the most critical materials, risks, and exceptions based on impact and urgency.' },
  { title: 'Embed Intelligence Logic', text: 'Apply rule-based target calculations, replenishment logic, and optimization parameters directly within SAP.' },
  { title: 'Reduce Planning Volatility and Signal Noise', text: 'Stabilize planning signals through structured parameter governance and controlled execution thresholds.' },
  { title: 'Optimize Purchase and Transport Decisions', text: 'Bundle purchase orders, manage restrictions, and align coverage with transport and cost considerations.' },
  { title: 'Sequence Production Against Real Capacity', text: 'Plan against real capacities with sequencing, setup optimization, and bottleneck transparency.' },
  { title: 'Maintain a Clean Core', text: 'Strengthen standard SAP processes without introducing external planning engines or replication layers.' },
];
---
<Layout title="GIB Platform | SAP Supply Chain Operations & Performance Management" description="Optimize supply chain performance in SAP. GIB provides operational control across MRP, inventory, forecasting, and production scheduling." current="sap">
  <Section tone="dark">
    <div class="gib-hero">
      <div>
        <Eyebrow text="GIB for SAP" />
        <h1>Built-in cross-functional intelligence for supply chains running on SAP</h1>
        <p class="gib-lead">Does your supply chain organization manually work through large volumes of operational signals in SAP?</p>
        <div class="gib-actions"><Button href={links.demo} external>Get a demo</Button></div>
      </div>
      <div class="gib-hero-panel"><Image src={hero} alt="GIB dashboard inside SAP with process indicators for demand planning, procurement, inventory and manufacturing" widths={[640, 960, 1280]} sizes="(min-width: 900px) 45vw, 100vw" loading="eager" fetchpriority="high" /></div>
    </div>
  </Section>

  <Section tone="white">
    <p class="gib-lead">The GIB platform delivers a suite of embedded solutions designed to strengthen operational control, coordination, and execution from demand through production - reducing manual processes, improving responsiveness, and protecting performance at scale.</p>
  </Section>

  <Section tone="light">
    <h2 class="reveal">Reduce manual coordination work in SAP</h2>
    <div class="gib-capabilities">{capabilities.map((capability, i) => (
      <article class:list={['gib-card', 'reveal', `reveal-delay-${i%4+1}`]}>
        <span class="gib-number">{String(i+1).padStart(2, '0')}</span>
        <h3>{capability.title}</h3>
        <p>{capability.text}</p>
      </article>
    ))}</div>
    <p class="gib-capabilities-close">These capabilities enable planning, procurement, and production teams to operate in continuous alignment, strengthening supply chain performance while preserving system integrity within SAP.</p>
  </Section>

  <Section tone="dark">
    <Quote featured text="Before we implemented GIB our buyers were changing 80% of the purchase requisitions generated by SAP MRP. With GIB embedded in SAP, our buyers now accept over 80% of the recommended purchase requisitions. The intelligence GIB brought to our business improved buyer productivity four fold." name="Director of Purchasing" role="Construction Materials, Wholesale Distribution" />
  </Section>

  <Section tone="white">
    <h2 class="reveal">Built-in solutions for managing supply chain operations in SAP</h2>
    <ModuleCards />
  </Section>
  <CtaBand heading="See GIB working inside SAP." text="" />
</Layout>

<style>
  .gib-capabilities { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2rem; }
  .gib-capabilities-close { margin-top: 2rem; }
  .gib-number { font-size: 1.4rem; }
  @media (max-width: 899px) { .gib-capabilities { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .gib-capabilities { grid-template-columns: 1fr; } }
</style>
