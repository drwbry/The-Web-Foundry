---
const {items} = Astro.props;
---
<div class="gib-stats">{items.map((item,i) => <div class:list={['gib-stat','reveal',`reveal-delay-${i+1}`]}><div class="gib-stat-value">{item.text || <><span class="gib-stat-affix">{item.prefix}</span><span data-count={item.value}>{item.value}</span><span class="gib-stat-affix">{item.suffix}</span></>}</div><p>{item.label}</p>{item.source && <small>{item.source}</small>}</div>)}</div>
<script is:inline>
  // Keep the real HTML values when reduced motion is requested, before shared.js starts counters.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.currentScript.previousElementSibling.querySelectorAll('[data-count]').forEach(el => el.removeAttribute('data-count'));
  }
</script>
<style>
.gib-stats {display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:2.5rem;border-top:1px solid color-mix(in srgb,currentColor 22%,transparent);}
.gib-stat {padding:1.75rem 1.5rem 0 0;min-width:0;position:relative;}
.gib-stat + .gib-stat {padding-left:1.5rem;border-left:1px solid color-mix(in srgb,currentColor 22%,transparent);}
.gib-stat::before {content:'';position:absolute;top:-2px;left:0;width:56px;height:3px;background:var(--gib-orange);} .gib-stat + .gib-stat::before {left:-1px;}
.gib-stat-value {font-family:var(--gib-ff-display);font-variation-settings:'wdth' 96;font-weight:800;font-size:clamp(3rem,6.4vw,5.6rem);line-height:.95;letter-spacing:-.045em;margin-bottom:1rem;font-variant-numeric:tabular-nums;white-space:nowrap;}
.gib-stat-affix {font-size:.45em;letter-spacing:-.01em;color:var(--gib-orange);margin-left:.08em;font-weight:700;} .gib-stat-affix:first-child {margin:0 .12em 0 0;} .gib-stat-affix:empty {display:none;}
.gib-stat p {font-size:1rem;line-height:1.4;max-width:24ch;margin:0;}
small {display:block;font:.72rem var(--gib-ff-mono);letter-spacing:.1em;text-transform:uppercase;opacity:.65;margin-top:1rem;}
@media(max-width:899px) {.gib-stats {grid-template-columns:repeat(2,minmax(0,1fr));border-top:0;} .gib-stat, .gib-stat + .gib-stat {padding:1.5rem 1rem 1.5rem 0;border-left:0;border-top:1px solid color-mix(in srgb,currentColor 22%,transparent);} .gib-stat::before, .gib-stat + .gib-stat::before {left:0;}}
</style>
