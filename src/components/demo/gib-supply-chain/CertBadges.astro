---
import {Image} from 'astro:assets';
import clean from '../../../assets/demo/gib-supply-chain/logos/sap-cert-clean-core.png';
import rise from '../../../assets/demo/gib-supply-chain/logos/sap-cert-rise.png';
import integration from '../../../assets/demo/gib-supply-chain/logos/sap-cert-integration.png';
// The three source images carry different built-in whitespace, so equal heights
// look unequal. Each gets its own display height so the lettering lines up.
const badges=[[clean,'SAP Certified: clean core, SAP S/4HANA Cloud',22],[rise,'SAP Certified: works with RISE with SAP',26],[integration,'SAP Certified: integration with SAP S/4HANA',36]];
---
<div class="gib-badges">{badges.map(([src,alt,h]) => <span><Image src={src} alt={alt} height={h*2} style={`height:${h}px`} /></span>)}</div>
<style>
.gib-badges {display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.5rem;} span {background:white;border-radius:8px;padding:0 .8rem;height:48px;display:flex;align-items:center;} img {width:auto;}
</style>
