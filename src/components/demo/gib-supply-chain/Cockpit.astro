---
import {Image} from 'astro:assets';
import Button from './Button.astro';
const {label, views, initial=0, id} = Astro.props;
const number = (n) => String(n+1).padStart(2,'0');
---
<div class="gib-cockpit" data-cockpit>
  <div class="gib-cockpit-title"><span class="gib-cockpit-lights" aria-hidden="true"><i></i><i></i><i></i></span><span>{label}</span><span class="gib-cockpit-counter" data-counter>{number(initial)} / {String(views.length).padStart(2,'0')}</span></div>
  <div class="gib-cockpit-body">
    <div class="gib-cockpit-rail" role="tablist" aria-label={`${label} views`} aria-orientation="vertical">{views.map((view,i) => <button type="button" role="tab" id={`${id}-tab-${view.key}`} aria-selected={i===initial ? 'true':'false'} tabindex={i===initial?0:-1}><span class="gib-cockpit-number">{number(i)}</span><span>{view.title}{view.tag && <small>{view.tag}</small>}</span></button>)}</div>
    <div class="gib-cockpit-screens">{views.map((view,i) => i===initial ? <div role="tabpanel" id={`${id}-${view.key}`} aria-labelledby={`${id}-tab-${view.key}`} tabindex={!view.shot && !view.href && i===initial ? 0 : undefined}><div class="gib-cockpit-screen">
      {view.kicker && <p class="gib-cockpit-kicker">{view.kicker}</p>}<h3>{view.title}</h3>{view.text && view.text.split('\n\n').map(text => <p>{text}</p>)}
      {view.bullets && <ul class="gib-checks">{view.bullets.map(text => <li>{text}</li>)}</ul>}
      {view.href && <Button href={view.href} variant="link">{view.hrefLabel}</Button>}
      {view.shot && <a class="gib-cockpit-image" href={view.shot.src} target="_blank" rel="noopener" aria-label={`${view.alt || view.title}, open full-size image`}><Image src={view.shot} alt={view.alt || `${view.title} supply chain cockpit inside SAP`} widths={[640,960,1280,1920]} sizes="(min-width:900px) 65vw, 100vw" loading={i===initial ? 'eager':'lazy'} /></a>}
    </div></div> : <div role="tabpanel" id={`${id}-${view.key}`} aria-labelledby={`${id}-tab-${view.key}`} hidden="until-found" tabindex={!view.shot && !view.href && i===initial ? 0 : undefined}><div class="gib-cockpit-screen">
      {view.kicker && <p class="gib-cockpit-kicker">{view.kicker}</p>}<h3>{view.title}</h3>{view.text && view.text.split('\n\n').map(text => <p>{text}</p>)}
      {view.bullets && <ul class="gib-checks">{view.bullets.map(text => <li>{text}</li>)}</ul>}
      {view.href && <Button href={view.href} variant="link">{view.hrefLabel}</Button>}
      {view.shot && <a class="gib-cockpit-image" href={view.shot.src} target="_blank" rel="noopener" aria-label={`${view.alt || view.title}, open full-size image`}><Image src={view.shot} alt={view.alt || `${view.title} supply chain cockpit inside SAP`} widths={[640,960,1280,1920]} sizes="(min-width:900px) 65vw, 100vw" loading={i===initial ? 'eager':'lazy'} /></a>}
    </div></div>)}</div>
  </div>
  <div class="gib-cockpit-status"><span><i aria-hidden="true"></i>Inside SAP S/4HANA and SAP ECC</span><span>No separate database. No middleware.</span></div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-cockpit]').forEach(root => {
    const rail = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = [...rail.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const mobile = matchMedia('(max-width:899px)');
    const select = (index: number, focus = false, scroll = true) => {
      if (index < 0) return;
      tabs.forEach((tab,i) => { tab.setAttribute('aria-selected',String(i===index)); tab.tabIndex = i===index ? 0 : -1; });
      panels.forEach((panel,i) => {
        if (i===index) panel.removeAttribute('hidden'); else panel.setAttribute('hidden','until-found');
        if (!panel.querySelector('a,button')) { if (i===index) panel.tabIndex=0; else panel.removeAttribute('tabindex'); }
      });
      root.querySelector('[data-counter]')!.textContent = `${String(index+1).padStart(2,'0')} / ${String(tabs.length).padStart(2,'0')}`;
      if (focus) tabs[index].focus({preventScroll:true});
      if (mobile.matches && scroll) tabs[index].scrollIntoView({inline:'nearest',block:'nearest'});
    };
    tabs.forEach((tab,i) => tab.addEventListener('click',() => select(i)));
    rail.addEventListener('keydown',e => {
      const index = tabs.indexOf(document.activeElement as HTMLButtonElement);
      const next = mobile.matches ? 'ArrowRight' : 'ArrowDown', prev = mobile.matches ? 'ArrowLeft' : 'ArrowUp';
      let target = e.key===next ? (index+1)%tabs.length : e.key===prev ? (index-1+tabs.length)%tabs.length : e.key==='Home' ? 0 : e.key==='End' ? tabs.length-1 : -1;
      if (target>=0) { e.preventDefault(); select(target,true); }
    });
    root.addEventListener('beforematch',e => select(panels.indexOf(e.target as HTMLElement)));
    const fromHash = () => { const index=panels.findIndex(p => `#${p.id}`===location.hash); if(index>=0) select(index,false,false); };
    const orientation = () => rail.setAttribute('aria-orientation',mobile.matches?'horizontal':'vertical');
    mobile.addEventListener('change',orientation); orientation();
    window.addEventListener('hashchange',fromHash); fromHash();
  });
</script>
<style>
.gib-cockpit {border:1px solid var(--gib-ink-3);border-radius:14px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.35);background:var(--gib-ink);color:var(--gib-on-dark);margin-top:2rem;min-width:0;}
.gib-cockpit-title {height:40px;background:var(--gib-ink-2);display:flex;align-items:center;gap:1rem;padding:0 1rem;font:.8rem var(--gib-ff-mono);}
.gib-cockpit-lights {display:flex;gap:5px;} .gib-cockpit-lights i {height:9px;width:9px;border-radius:50%;background:var(--gib-red);} .gib-cockpit-lights i:nth-child(2) {background:var(--gib-amber);} .gib-cockpit-lights i:nth-child(3) {background:var(--gib-green);}
.gib-cockpit-counter {margin-left:auto;white-space:nowrap;color:var(--gib-on-dark-muted);}
.gib-cockpit-body {display:grid;grid-template-columns:280px minmax(0,1fr);}
.gib-cockpit-rail {background:var(--gib-ink-2);border-right:1px solid var(--gib-ink-3);padding-block:.5rem;}
.gib-cockpit-rail button {position:relative;width:100%;display:flex;text-align:left;align-items:flex-start;gap:.8rem;padding:1rem;border:0;background:transparent;color:var(--gib-on-dark-muted);font:500 .95rem/1.4 var(--gib-ff);cursor:pointer;min-height:44px;}
.gib-cockpit-rail button[aria-selected="true"] {background:var(--gib-ink-3);color:var(--gib-white);}
.gib-cockpit-rail button[aria-selected="true"]::after {content:'';position:absolute;inset:0 auto 0 0;border-left:3px solid var(--gib-orange);}
.gib-cockpit-rail button:focus-visible {outline-offset:-5px;}
.gib-cockpit-number {font:.75rem/1.8 var(--gib-ff-mono);color:var(--gib-on-dark-muted);}
.gib-cockpit-rail small {display:block;width:max-content;font:.65rem var(--gib-ff-mono);color:var(--gib-orange);border:1px solid var(--gib-orange);border-radius:20px;padding:.25rem .5rem;margin-top:.5rem;}
.gib-cockpit-screens {display:grid;min-width:0;align-items:start;}
[role="tabpanel"] {grid-area:1 / 1;min-width:0;}
.gib-cockpit-screen {padding:1.5rem;animation:gib-screen-in .2s var(--gib-ease);}
.gib-cockpit-kicker {font:.75rem var(--gib-ff-mono);text-transform:uppercase;letter-spacing:.08em;color:var(--gib-orange);}
.gib-cockpit-screen p {color:var(--gib-on-dark-muted);font-size:.95rem;}
.gib-cockpit-screen :global(.gib-checks) {font-size:.85rem;gap:.5rem 1rem;}
.gib-cockpit-screen :global(.gib-button-link) {color:var(--gib-orange);margin-bottom:.75rem;}
.gib-cockpit-image {display:block;border:1px solid var(--gib-ink-3);border-radius:8px;overflow:hidden;margin-top:1rem;}
.gib-cockpit-image img {display:block;width:100%;}
.gib-cockpit-status {min-height:32px;display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.4rem 1rem;background:var(--gib-ink-2);color:var(--gib-on-dark-muted);font:.65rem var(--gib-ff-mono);}
.gib-cockpit-status i {display:inline-block;width:6px;height:6px;background:var(--gib-green);border-radius:50%;margin-right:.5rem;}
@keyframes gib-screen-in {from {opacity:0;} to {opacity:1;}}
@media(max-width:899px) {.gib-cockpit-body {grid-template-columns:minmax(0,1fr);} .gib-cockpit-rail {display:flex;overflow-x:auto;border-right:0;border-bottom:1px solid var(--gib-ink-3);padding:.5rem;gap:.5rem;scroll-snap-type:inline proximity;} .gib-cockpit-rail button {flex:none;width:auto;max-width:300px;border-radius:6px;scroll-snap-align:start;padding:.75rem 1rem;} .gib-cockpit-status>span:last-child {display:none;} .gib-cockpit-screen {padding:1rem;} .gib-cockpit-screen :global(.gib-checks) {grid-template-columns:1fr;}}
@media(prefers-reduced-motion:reduce) {.gib-cockpit-screen {animation:none;}}
</style>
