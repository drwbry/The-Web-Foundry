---
import {Image} from 'astro:assets';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
const {eyebrow,title,text,href,image} = Astro.props;
---
<article class:list={['gib-case','reveal',{'gib-case-image':!!image}]}><div class="gib-case-copy"><Eyebrow text={eyebrow} /><h2>{title}</h2><p>{text}</p><Button href={href} variant="link" external>Read the case study</Button></div>{image && <Image src={image} alt={title} widths={[640,960]} sizes="(min-width:900px) 45vw, 100vw" />}</article>
<style>
.gib-case {background:var(--gib-white);border:1px solid var(--gib-line);border-left:4px solid var(--gib-orange);border-radius:14px;overflow:hidden;color:var(--gib-text);}
.gib-case-copy {padding:clamp(1.5rem,4vw,3rem);} .gib-case-image {display:grid;grid-template-columns:1fr 1fr;border-left:1px solid var(--gib-line);}
img {width:100%;height:100%!important;object-fit:cover;} @media(max-width:899px) {.gib-case-image {grid-template-columns:1fr;} img {max-height:360px;}}
</style>
