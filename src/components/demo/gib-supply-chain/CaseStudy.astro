---
import {Image} from 'astro:assets';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
const {eyebrow,title,text,href,image} = Astro.props;
---
<article class:list={['gib-case','reveal',{'gib-case-image':!!image}]}><div class="gib-case-copy"><Eyebrow text={eyebrow} /><h2>{title}</h2><p>{text}</p><Button href={href} variant="ghost" external>Read the case study</Button></div>{image && <div class="gib-case-media"><Image src={image} alt={title} widths={[640,960]} sizes="(min-width:900px) 45vw, 100vw" /></div>}</article>
<style>
.gib-case {background:var(--gib-grid),var(--gib-ink);color:var(--gib-on-dark);border-radius:10px;overflow:hidden;position:relative;}
.gib-case::after {content:'';position:absolute;right:-10%;bottom:-60%;width:60%;aspect-ratio:1;background:radial-gradient(circle,rgba(243,112,33,.28),transparent 65%);pointer-events:none;}
.gib-case-copy {padding:clamp(1.75rem,5vw,4rem);position:relative;z-index:1;} .gib-case-copy :global(.gib-eyebrow) {color:var(--gib-on-dark-muted);}
.gib-case h2 {max-width:24ch!important;font-size:clamp(1.7rem,3.2vw,2.7rem)!important;} .gib-case p {color:var(--gib-on-dark-muted);max-width:58ch;margin-bottom:1.75rem!important;}
.gib-case-image {display:grid;grid-template-columns:1.1fr .9fr;} .gib-case-media {position:relative;z-index:1;min-height:100%;}
img {width:100%;height:100%!important;object-fit:cover;display:block;} @media(max-width:899px) {.gib-case-image {grid-template-columns:1fr;} img {max-height:320px;}}
</style>
