---
import {Image} from 'astro:assets';
import agilent from '../../../assets/demo/gib-supply-chain/logos/agilent.png';
import basf from '../../../assets/demo/gib-supply-chain/logos/basf-chemetall.png';
import borgwarner from '../../../assets/demo/gib-supply-chain/logos/borgwarner.png';
import dana from '../../../assets/demo/gib-supply-chain/logos/dana.png';
import tata from '../../../assets/demo/gib-supply-chain/logos/tata.png';
import te from '../../../assets/demo/gib-supply-chain/logos/te-connectivity.png';
const logos=[[agilent,'Agilent'],[basf,'BASF Chemetall'],[borgwarner,'BorgWarner'],[dana,'Dana'],[tata,'Tata'],[te,'TE Connectivity']];
---
<section class="gib-logowall"><div class="gib-wrap gib-logowall-inner"><p class="gib-logowall-label"><strong>25+ years</strong> of SAP supply chain expertise, trusted in complex manufacturing and distribution worldwide.</p><ul class="gib-logos">{logos.map(([src,alt]) => <li><Image src={src} alt={alt} height={72} /></li>)}</ul></div></section>
<style>
.gib-logowall {background:var(--gib-white);border-bottom:1px solid var(--gib-line);padding-block:2.25rem;}
.gib-logowall-inner {display:grid;grid-template-columns:minmax(220px,300px) 1fr;gap:2rem 3.5rem;align-items:center;}
.gib-logowall-label {font-size:.92rem;line-height:1.45;color:var(--gib-muted);margin:0!important;} .gib-logowall-label strong {color:var(--gib-text);font-weight:700;}
.gib-logos {display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:1rem 2.25rem;align-items:center;list-style:none;padding:0;margin:0;} .gib-logos li {display:flex;align-items:center;justify-content:center;}
img {max-width:100%;max-height:36px;width:auto;object-fit:contain;filter:grayscale(1) contrast(1.1);opacity:.72;mix-blend-mode:multiply;transition:filter .25s,opacity .25s;} li:hover img {filter:none;opacity:1;}
@media(max-width:899px) {.gib-logowall-inner {grid-template-columns:1fr;} .gib-logos {grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;}}
</style>
