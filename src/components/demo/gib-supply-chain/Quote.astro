---
const {text,name,role,featured=false} = Astro.props;
---
<figure class:list={['gib-quote','reveal',{'gib-quote-featured':featured}]}><span class="gib-quote-mark" aria-hidden="true">“</span><blockquote><p>{text}</p></blockquote><figcaption><strong>{name}</strong>{role && <span>{role}</span>}</figcaption></figure>
<style>
.gib-quote {margin:0;padding:1.5rem 0;}
.gib-quote-mark {display:block;color:var(--gib-orange-ink);font-size:5rem;line-height:.8;font-weight:700;}
blockquote {margin:0;} blockquote p {font-size:1.0625rem;line-height:1.6;}
figcaption {margin-top:1.5rem;font-size:.9rem;} figcaption span {display:block;color:var(--gib-muted);}
.gib-quote-featured {max-width:900px;margin-inline:auto;text-align:center;} .gib-quote-featured blockquote p {font-size:clamp(1.8rem,3.2vw,2.6rem);line-height:1.3;letter-spacing:-.015em;}
:global(.gib-section-dark) .gib-quote-mark {color:var(--gib-orange);} :global(.gib-section-dark) figcaption span {color:var(--gib-on-dark-muted);}
</style>
