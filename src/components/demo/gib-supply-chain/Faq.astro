---
const {items} = Astro.props;
---
<div class="gib-faq">{items.map((item,i) => <details name="gib-faq" open={i===0}><summary><span class="gib-faq-n">{String(i+1).padStart(2,'0')}</span>{item.q}<span aria-hidden="true" class="gib-faq-icon"></span></summary><p>{item.a}</p></details>)}</div>
<style>
details {border-top:1px solid var(--gib-line);} details:last-child {border-bottom:1px solid var(--gib-line);}
summary {list-style:none;font-size:1.2rem;font-weight:600;line-height:1.3;cursor:pointer;display:flex;gap:1.25rem;align-items:baseline;padding:1.35rem 0;transition:color .2s;} summary::-webkit-details-marker {display:none;} summary:hover {color:var(--gib-orange-ink);}
.gib-faq-n {font:400 .74rem var(--gib-ff-mono);color:var(--gib-muted);flex:none;}
.gib-faq-icon {margin-left:auto;flex:none;position:relative;width:14px;height:14px;align-self:center;} .gib-faq-icon::before,.gib-faq-icon::after {content:'';position:absolute;inset:6px 0 auto 0;height:2px;background:var(--gib-orange);transition:transform .25s var(--gib-ease);} .gib-faq-icon::after {transform:rotate(90deg);} details[open] .gib-faq-icon::after {transform:rotate(0);}
p {padding:0 2rem 1.5rem 2.6rem;color:var(--gib-muted);margin:0!important;}
@media(prefers-reduced-motion:reduce) {.gib-faq-icon::before,.gib-faq-icon::after {transition:none;}}
</style>
