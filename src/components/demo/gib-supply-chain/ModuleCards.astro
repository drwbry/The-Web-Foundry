---
import {base,products} from './data.js';
const {exclude} = Astro.props;
const list = Object.values(products);
---
<div class="gib-modules">{list.filter(p => p.slug!==exclude).map((p,i) => <a href={`${base}/${p.slug}`} class:list={['gib-module','reveal',`reveal-delay-${i+1}`]}><span class="gib-module-n">{String(list.indexOf(p)+1).padStart(2,'0')}</span><span class="gib-module-cat">{p.category}</span><h3>{p.name}{p.popular && <span class="gib-popular">Most popular</span>}</h3><p>{p.summary}</p><span class="gib-module-go">{p.verb} <i aria-hidden="true">→</i></span></a>)}</div>
<style>
.gib-modules {display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.25rem;margin-block:2rem 1.5rem;}
.gib-module {position:relative;background:var(--gib-white);color:var(--gib-text);border:1px solid var(--gib-line);padding:1.75rem;border-radius:var(--gib-radius);display:flex;flex-direction:column;align-items:flex-start;text-decoration:none;transition:transform .3s var(--gib-ease),border-color .3s,box-shadow .3s;overflow:hidden;}
.gib-module::after {content:'';position:absolute;left:0;bottom:0;height:3px;width:100%;background:var(--gib-orange);transform:scaleX(0);transform-origin:left;transition:transform .35s var(--gib-ease);}
.gib-module:hover {transform:translateY(-4px);border-color:var(--gib-text);box-shadow:var(--gib-shadow);} .gib-module:hover::after {transform:scaleX(1);}
.gib-module-n {font:400 .74rem var(--gib-ff-mono);color:var(--gib-muted);} .gib-module-cat {font:500 .68rem var(--gib-ff-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--gib-orange-ink);margin-top:2.5rem;}
h3 {font-family:var(--gib-ff-display);font-size:1.6rem!important;font-weight:750!important;letter-spacing:-.025em!important;margin:.35rem 0 .75rem!important;display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;}
p {color:var(--gib-muted);font-size:.95rem;line-height:1.5;margin-bottom:1.5rem!important;}
.gib-module-go {margin-top:auto;font-weight:600;font-size:.95rem;display:inline-flex;gap:.5rem;} .gib-module-go i {font-style:normal;transition:transform .25s var(--gib-ease);} .gib-module:hover .gib-module-go i {transform:translateX(4px);}
.gib-popular {font:500 .62rem var(--gib-ff-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--gib-ink);background:var(--gib-orange);padding:.25rem .5rem;border-radius:3px;}
@media(prefers-reduced-motion:reduce) {.gib-module,.gib-module::after,.gib-module-go i {transition:none;}}
</style>
